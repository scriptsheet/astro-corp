        const UPGRADES_CONFIG = [
            { id: 'upg1', name: 'Titanium Drill Bits', desc: 'Rover Drones produce 2x profit', cost: 100, targetGen: 'gen1', multiplier: 2 },
            { id: 'upg2', name: 'Diamond Cutter Arrays', desc: 'Lunar Drills produce 2x profit', cost: 1000, targetGen: 'gen2', multiplier: 2 },
            { id: 'upg3', name: 'Plasma Cutters', desc: 'Asteroid Harvesters produce 2x profit', cost: 11000, targetGen: 'gen3', multiplier: 2 },
            { id: 'upg4', name: 'AI Logistics Drone Net', desc: 'Global +50% income across all facilities', cost: 50000, isGlobal: true, multiplier: 1.5 },
            { id: 'upg5', name: 'Laser Overcharge', desc: 'Manual clicks gain +3% of your total CPS', cost: 25000 },
            { id: 'upg6', name: 'Sub-Zero Coolers', desc: 'Orbital Refineries produce 2x profit', cost: 200000, targetGen: 'gen4', multiplier: 2 },
            { id: 'upg7', name: 'Solar Flares Harness', desc: 'Dyson Collectors produce 2x profit', cost: 2500000, targetGen: 'gen5', multiplier: 2 },
            { id: 'upg8', name: 'Quantum Core Synergies', desc: 'Global income 2x boost', cost: 10000000, isGlobal: true, multiplier: 2 }
        ];

        const PRESTIGE_PERKS_CONFIG = [
            { id: 'perk_warp', name: 'Warp Drive Logistics', desc: '-10% Generator base cycle speeds per level', baseCost: 5, maxLvl: 5 },
            { id: 'perk_grant', name: 'Corporate Seed Grant', desc: 'Start new runs with +$5,000 bonus credits per level', baseCost: 10, maxLvl: 5 },
            { id: 'perk_nano', name: 'Nanotech Fabrication', desc: '-10% Facility upgrade costs per level', baseCost: 15, maxLvl: 5 },
            { id: 'perk_frenzy', name: 'Dark Matter Overdrive', desc: '+5s Stardust Frenzy duration and +1x multiplier', baseCost: 25, maxLvl: 3 }
        ];

        /**
         * GAME STATE MODEL
         */
        let state = {
            cash: 0,
            lifetimeCash: 0,
            clickPower: 1,
            clickLevel: 1,
            clickCost: 10,
            totalClicks: 0,
            totalPrestiges: 0,
            timePlayed: 0,
            darkMatter: 0,
            lastSaveTime: Date.now(),
            
            // Generator levels & automated managers
            generators: {},
            managers: {},
            upgrades: {},
            perks: {}
        };

        let buyMode = '1'; // '1', '10', '100', 'max'
        let frenzyActive = false;
        let frenzyTimeLeft = 0;
        let frenzyMultiplier = 2;
        let sparklineData = new Array(20).fill(0);
        let beaconToastTimer = null;

        /**
         * CUSTOM NON-BLOCKING DIALOG SYSTEM
         */
        function showDialog({ title, message, showCancel = false, showInput = false, inputValue = '', onConfirm = null }) {
            const modal = document.getElementById('modal-dialog');
            const titleEl = document.getElementById('dialog-title');
            const msgEl = document.getElementById('dialog-message');
            const inputEl = document.getElementById('dialog-input');
            const cancelBtn = document.getElementById('dialog-cancel');
            const confirmBtn = document.getElementById('dialog-confirm');

            titleEl.innerText = title || 'SYSTEM NOTICE';
            msgEl.innerText = message || '';

            if (showInput) {
                inputEl.classList.remove('hidden');
                inputEl.value = inputValue;
            } else {
                inputEl.classList.add('hidden');
                inputEl.value = '';
            }

            if (showCancel) {
                cancelBtn.classList.remove('hidden');
            } else {
                cancelBtn.classList.add('hidden');
            }

            modal.classList.remove('hidden');

            cancelBtn.onclick = () => {
                modal.classList.add('hidden');
            };

            confirmBtn.onclick = () => {
                const val = inputEl.value;
                modal.classList.add('hidden');
                if (onConfirm) onConfirm(val);
            };
        }

        /**
         * BEACON CALCULATIONS
         */
        function getMilestonesForLevel(lvl) {
            if (lvl < 10) return 0;
            if (lvl < 25) return 1;
            if (lvl < 50) return 2;
            if (lvl < 100) return 3;
            return 4 + Math.floor((lvl - 100) / 50);
        }

        function getNextMilestoneLevel(lvl) {
            const milestoneThresholds = [10, 25, 50, 100];
            for (let m of milestoneThresholds) {
                if (m > lvl) return m;
            }
            return 100 + (Math.floor((lvl - 100) / 50) + 1) * 50;
        }

        function getPrevMilestoneLevel(lvl) {
            if (lvl < 10) return 0;
            if (lvl < 25) return 10;
            if (lvl < 50) return 25;
            if (lvl < 100) return 50;
            return 100 + Math.floor((lvl - 100) / 50) * 50;
        }

        function getTotalBeacons() {
            let beacons = 0;
            GENERATORS_CONFIG.forEach(g => {
                const lvl = state.generators[g.id] ? state.generators[g.id].level : 0;
                beacons += getMilestonesForLevel(lvl);
            });
            return beacons;
        }

        function getBeaconMultiplier() {
            return 1 + getTotalBeacons() * 0.10;
        }

        function showBeaconNotification(facilityName, count, total) {
            const toast = document.getElementById('beacon-toast');
            document.getElementById('beacon-toast-title').innerText = `📡 ${count > 1 ? `${count} BEACONS` : 'BEACON'} UNLOCKED!`;
            document.getElementById('beacon-toast-desc').innerText = `${facilityName} reached a milestone! You now have ${total} Beacon${total > 1 ? 's' : ''} (+${total * 10}% output boost).`;
            
            toast.classList.remove('hidden');
            if (beaconToastTimer) clearTimeout(beaconToastTimer);
            beaconToastTimer = setTimeout(() => {
                toast.classList.add('hidden');
            }, 4500);
        }

        // Helper to calculate active click power (base + % of CPS) with Beacons and Math.ceil rounding
        function getEffectiveClickPower() {
            const cpsBonus = state.upgrades['upg5'] ? getGlobalCPS() * 0.03 : 0;
            const base = state.clickPower + cpsBonus;
            const total = base * getBeaconMultiplier();
            return Math.ceil(total);
        }

        // Initialize state objects
        function initInitialState() {
            GENERATORS_CONFIG.forEach(g => {
                if (!state.generators[g.id]) state.generators[g.id] = { level: 0, progress: 0, running: false };
                if (state.managers[g.id] === undefined) state.managers[g.id] = false;
            });
            UPGRADES_CONFIG.forEach(u => {
                if (state.upgrades[u.id] === undefined) state.upgrades[u.id] = false;
            });
            PRESTIGE_PERKS_CONFIG.forEach(p => {
                if (state.perks[p.id] === undefined) state.perks[p.id] = 0;
            });
        }
        initInitialState();

        /**
         * CORE MATHEMATICAL CALCULATIONS
         */

        // Get cost for N levels of a generator
        function getGeneratorCost(genId, count = 1) {
            const config = GENERATORS_CONFIG.find(g => g.id === genId);
            const currentLvl = state.generators[genId].level;
            const costMult = 1.15;
            
            // Perk reduction
            const discount = 1 - (state.perks['perk_nano'] || 0) * 0.10;

            if (count === 'max') {
                // Calculate max affordable
                let maxCount = 0;
                let tempCost = 0;
                let c = config.baseCost * Math.pow(costMult, currentLvl) * discount;
                let available = state.cash;
                while (available >= c) {
                    available -= c;
                    tempCost += c;
                    maxCount++;
                    c = config.baseCost * Math.pow(costMult, currentLvl + maxCount) * discount;
                    if (maxCount >= 1000) break;
                }
                return { totalCost: Math.max(config.baseCost * discount, tempCost), count: Math.max(1, maxCount) };
            }

            let totalCost = 0;
            for (let i = 0; i < count; i++) {
                totalCost += config.baseCost * Math.pow(costMult, currentLvl + i) * discount;
            }
            return { totalCost, count };
        }

        // Get total CPS (Cash Per Second) across all facilities
        function getGlobalCPS() {
            let totalCPS = 0;

            // Global Multiplier from Dark Matter, Beacons & Upgrades
            let globalMult = 1.0;
            globalMult += state.darkMatter * 0.05; // Each DM = +5%
            globalMult *= getBeaconMultiplier();  // Each Beacon = +10%

            UPGRADES_CONFIG.forEach(u => {
                if (u.isGlobal && state.upgrades[u.id]) globalMult *= u.multiplier;
            });

            if (frenzyActive) globalMult *= frenzyMultiplier;

            GENERATORS_CONFIG.forEach(g => {
                const lvl = state.generators[g.id].level;
                if (lvl > 0) {
                    let genIncome = g.baseIncome * lvl;

                    // Upgrade Multipliers
                    UPGRADES_CONFIG.forEach(u => {
                        if (u.targetGen === g.id && state.upgrades[u.id]) {
                            genIncome *= u.multiplier;
                        }
                    });

                    // Cycle Speed / CPS conversion
                    let speed = g.baseSpeed * Math.max(0.5, 1 - (state.perks['perk_warp'] || 0) * 0.10);
                    let cps = genIncome / speed;
                    totalCPS += cps;
                }
            });

            return Math.ceil(totalCPS * globalMult);
        }

        /**
         * RENDER & UI UPDATES
         */
        function renderUI() {
            const cps = getGlobalCPS();
            const beacons = getTotalBeacons();
            const beaconBonusPercent = Math.round(beacons * 10);

            // Financial Dashboard
            document.getElementById('display-cash').innerText = formatNumber(state.cash);
            document.getElementById('display-cps').innerText = formatNumber(cps);
            document.getElementById('display-beacons').innerText = `📡 ${beacons}`;
            document.getElementById('display-beacon-bonus').innerText = `+${beaconBonusPercent}%`;
            document.getElementById('display-dm').innerText = `${formatNumber(state.darkMatter)} DM`;
            document.getElementById('display-multiplier').innerText = `${(1 + state.darkMatter * 0.05).toFixed(2)}x`;

            // Manual Mining Laser Upgrade Button
            const activeClickPower = getEffectiveClickPower();
            document.getElementById('display-click-power').innerText = `+$${formatNumber(activeClickPower)}`;
            document.getElementById('display-click-cost').innerText = `$${formatNumber(state.clickCost)}`;
            document.getElementById('btn-upgrade-click').disabled = state.cash < state.clickCost;

            // Render Generator List
            const genContainer = document.getElementById('generators-container');
            genContainer.innerHTML = '';

            GENERATORS_CONFIG.forEach(g => {
                const genState = state.generators[g.id];
                const isAutomated = state.managers[g.id];
                const targetCount = buyMode === 'max' ? 'max' : parseInt(buyMode);
                const { totalCost, count } = getGeneratorCost(g.id, targetCount);

                // Calculate exact cycle speed
                const speed = (g.baseSpeed * Math.max(0.5, 1 - (state.perks['perk_warp'] || 0) * 0.10)).toFixed(1);

                // Next Beacon milestone thresholds calculation
                const nextMilestone = getNextMilestoneLevel(genState.level);
                const prevMilestone = getPrevMilestoneLevel(genState.level);
                const milestoneRange = Math.max(1, nextMilestone - prevMilestone);
                const milestoneProgress = Math.min(100, Math.max(0, ((genState.level - prevMilestone) / milestoneRange) * 100));

                const card = document.createElement('div');
                card.className = `glass-panel-interactive rounded-xl p-3 sm:p-4 flex flex-col gap-3 border ${genState.level > 0 ? 'border-cyan-500/30' : 'border-slate-800 opacity-80'}`;

                card.innerHTML = `
                    <div class="flex items-center justify-between gap-3">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-lg bg-slate-900 border border-slate-700 flex items-center justify-center text-xl">
                                ${g.icon}
                            </div>
                            <div>
                                <div class="font-orbitron font-bold text-sm text-slate-100 flex items-center gap-2 flex-wrap">
                                    <span>${g.name}</span>
                                    <span class="text-xs text-cyan-400 font-semibold bg-cyan-950/60 px-2 py-0.5 rounded border border-cyan-800/40">Lvl ${genState.level}</span>
                                    ${isAutomated 
                                        ? `<span class="text-[10px] text-emerald-300 bg-emerald-950/80 border border-emerald-500/50 px-2 py-0.5 rounded font-bold flex items-center gap-1">🤖 AUTOMATED</span>` 
                                        : `<span class="text-[10px] text-amber-300 bg-amber-950/80 border border-amber-500/40 px-2 py-0.5 rounded font-bold">👆 MANUAL</span>`
                                    }
                                </div>
                                <div class="text-[11px] text-slate-400 font-medium">
                                    +$${formatNumber(Math.ceil((g.baseIncome * Math.max(1, genState.level) * getBeaconMultiplier()) / speed))}/sec <span class="text-slate-500">(${speed}s cycle)</span>
                                </div>
                            </div>
                        </div>

                        <!-- Buy Button -->
                        <button data-buy-gen="${g.id}" class="px-4 py-2 bg-gradient-to-r from-cyan-600 to-sky-600 hover:from-cyan-500 hover:to-sky-500 text-slate-950 font-orbitron font-black text-xs rounded-xl shadow-md transition active:scale-95 disabled:opacity-30 disabled:pointer-events-none flex flex-col items-center min-w-[100px]" ${state.cash < totalCost ? 'disabled' : ''}>
                            <span>BUY x${count}</span>
                            <span class="text-[10px] text-slate-900 font-bold">$${formatNumber(totalCost)}</span>
                        </button>
                    </div>

                    <!-- Progress Bar & Manual Trigger Action -->
                    <div class="space-y-1">
                        <div class="flex justify-between items-center text-[10px] font-orbitron text-slate-400">
                            <span>PROGRESS ${genState.running ? '⚡ RUNNING' : 'IDLE'}</span>
                            <span class="text-cyan-400 font-semibold">NEXT BEACON: ${genState.level}/${nextMilestone}</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <!-- Main Cycle Bar -->
                            <div class="w-full h-3 bg-slate-950 rounded-full overflow-hidden border border-slate-800 relative cursor-pointer group" data-click-gen="${g.id}">
                                <div class="h-full bg-gradient-to-r from-cyan-500 via-sky-400 to-indigo-500 transition-all duration-75" style="width: ${genState.progress}%"></div>
                            </div>

                            <!-- Manual Run Button if not automated -->
                            ${!isAutomated ? `
                                <button data-run-gen="${g.id}" class="px-3 py-1 bg-amber-500/20 hover:bg-amber-500/40 border border-amber-500/50 text-amber-300 font-orbitron font-bold text-[10px] rounded-lg transition shrink-0 disabled:opacity-40" ${genState.level === 0 || genState.running ? 'disabled' : ''}>
                                    ${genState.running ? 'RUNNING...' : 'EXTRACT'}
                                </button>
                            ` : ''}
                        </div>
                        <!-- Beacon Milestone Sub-Bar -->
                        <div class="w-full h-1 bg-slate-950 rounded-full overflow-hidden" title="Progress towards next Beacon milestone">
                            <div class="h-full bg-cyan-400/90 shadow-[0_0_8px_rgba(6,182,212,0.8)]" style="width: ${milestoneProgress}%"></div>
                        </div>
                    </div>
                `;

                // Add Manual Run Click handler for bar & button
                const triggerManualRun = () => {
                    if (genState.level > 0 && !isAutomated && !genState.running) {
                        genState.running = true;
                        genState.progress = 0.1;
                    }
                };

                const progressElement = card.querySelector(`[data-click-gen="${g.id}"]`);
                if (progressElement) progressElement.onclick = triggerManualRun;

                const runBtn = card.querySelector(`[data-run-gen="${g.id}"]`);
                if (runBtn) runBtn.onclick = triggerManualRun;

                // Add Buy listener
                card.querySelector(`[data-buy-gen="${g.id}"]`).onclick = () => {
                    if (state.cash >= totalCost) {
                        const oldBeacons = getTotalBeacons();
                        state.cash -= totalCost;
                        genState.level += count;
                        
                        // Check for new Beacon unlocks
                        const newBeacons = getTotalBeacons();
                        if (newBeacons > oldBeacons) {
                            const gained = newBeacons - oldBeacons;
                            sounds.playBeacon();
                            showBeaconNotification(g.name, gained, newBeacons);
                        } else {
                            sounds.playBuy();
                        }

                        // Auto start running cycle if automated
                        if (state.managers[g.id]) {
                            genState.running = true;
                        }
                        renderUI();
                    }
                };

                genContainer.appendChild(card);
            });

            // Render Managers Tab
            const managersList = document.getElementById('managers-list');
            managersList.innerHTML = '';

            GENERATORS_CONFIG.forEach(g => {
                const cost = g.baseCost * 15;
                const hired = state.managers[g.id];
                const card = document.createElement('div');
                card.className = "bg-slate-900/90 border border-slate-800 p-3 rounded-xl flex items-center justify-between gap-3";
                card.innerHTML = `
                    <div class="flex items-center gap-3">
                        <div class="text-2xl">${g.icon}</div>
                        <div>
                            <div class="font-orbitron font-bold text-xs text-slate-200">${g.name} Executive AI</div>
                            <div class="text-[10px] text-slate-400">Automates ${g.name} extraction continuously</div>
                        </div>
                    </div>
                    <button data-hire="${g.id}" class="px-3 py-1.5 bg-cyan-600 hover:bg-cyan-500 text-slate-950 font-orbitron font-bold text-xs rounded-lg transition disabled:opacity-40 disabled:pointer-events-none" ${hired || state.cash < cost ? 'disabled' : ''}>
                        ${hired ? 'HIRED ✓' : `HIRE ($${formatNumber(cost)})`}
                    </button>
                `;
                card.querySelector(`[data-hire="${g.id}"]`).onclick = () => {
                    if (!hired && state.cash >= cost) {
                        state.cash -= cost;
                        state.managers[g.id] = true;
                        // Immediately set running state when manager is hired
                        if (state.generators[g.id] && state.generators[g.id].level > 0) {
                            state.generators[g.id].running = true;
                        }
                        sounds.playUpgrade();
                        renderUI();
                    }
                };
                managersList.appendChild(card);
            });

            // Render Tech Upgrades Tab
            const upgradesList = document.getElementById('upgrades-list');
            upgradesList.innerHTML = '';

            UPGRADES_CONFIG.forEach(u => {
                const bought = state.upgrades[u.id];
                const card = document.createElement('div');
                card.className = `bg-slate-900/90 border border-slate-800 p-3 rounded-xl flex items-center justify-between gap-3 ${bought ? 'opacity-50' : ''}`;
                card.innerHTML = `
                    <div>
                        <div class="font-orbitron font-bold text-xs text-cyan-300">${u.name}</div>
                        <div class="text-[10px] text-slate-400">${u.desc}</div>
                    </div>
                    <button data-upg="${u.id}" class="px-3 py-1.5 bg-gradient-to-r from-cyan-600 to-sky-600 hover:from-cyan-500 hover:to-sky-500 text-slate-950 font-orbitron font-bold text-xs rounded-lg transition disabled:opacity-30 disabled:pointer-events-none shrink-0" ${bought || state.cash < u.cost ? 'disabled' : ''}>
                        ${bought ? 'UNLOCKED ✓' : `$${formatNumber(u.cost)}`}
                    </button>
                `;
                card.querySelector(`[data-upg="${u.id}"]`).onclick = () => {
                    if (!bought && state.cash >= u.cost) {
                        state.cash -= u.cost;
                        state.upgrades[u.id] = true;
                        sounds.playUpgrade();
                        renderUI();
                    }
                };
                upgradesList.appendChild(card);
            });

            // Render Prestige Rebirth Details
            const potentialDM = Math.floor(15 * Math.sqrt(state.lifetimeCash / 1e7));
            document.getElementById('prestige-current-dm').innerText = `${formatNumber(state.darkMatter)} DM`;
            document.getElementById('prestige-current-multi').innerText = `${(1 + state.darkMatter * 0.05).toFixed(2)}x`;
            document.getElementById('prestige-gain-dm').innerText = `+${formatNumber(potentialDM)} DM`;
            document.getElementById('btn-rebirth').disabled = potentialDM <= 0;

            // Render Prestige Perks
            const perksList = document.getElementById('prestige-perks-list');
            perksList.innerHTML = '';

            PRESTIGE_PERKS_CONFIG.forEach(p => {
                const currentLvl = state.perks[p.id] || 0;
                const cost = p.baseCost * (currentLvl + 1);
                const isMax = currentLvl >= p.maxLvl;

                const card = document.createElement('div');
                card.className = "bg-slate-900/90 border border-purple-900/40 p-3 rounded-xl flex items-center justify-between gap-3";
                card.innerHTML = `
                    <div>
                        <div class="font-orbitron font-bold text-xs text-purple-300">${p.name} (Lvl ${currentLvl}/${p.maxLvl})</div>
                        <div class="text-[10px] text-slate-300">${p.desc}</div>
                    </div>
                    <button data-perk="${p.id}" class="px-3 py-1.5 bg-purple-600 hover:bg-purple-500 text-white font-orbitron font-bold text-xs rounded-lg transition disabled:opacity-30 disabled:pointer-events-none shrink-0" ${isMax || state.darkMatter < cost ? 'disabled' : ''}>
                        ${isMax ? 'MAX' : `${cost} DM`}
                    </button>
                `;
                card.querySelector(`[data-perk="${p.id}"]`).onclick = () => {
                    if (!isMax && state.darkMatter >= cost) {
                        state.darkMatter -= cost;
                        state.perks[p.id] = currentLvl + 1;
                        sounds.playUpgrade();
                        renderUI();
                    }
                };
                perksList.appendChild(card);
            });
        }

        /**
         * MANUAL CLICKING & FLOATING PARTICLES
         */
        document.getElementById('btn-mine').onclick = (e) => {
            sounds.playClick();
            const clickVal = getEffectiveClickPower();
            state.cash += clickVal;
            state.lifetimeCash += clickVal;
            state.totalClicks++;

            // Visual Ripple
            const ripple = document.getElementById('mine-ripple');
            ripple.style.opacity = '1';
            setTimeout(() => ripple.style.opacity = '0', 150);

            // Get click origin
            const rect = e.currentTarget.getBoundingClientRect();
            const x = e.clientX || (rect.left + rect.width / 2);
            const y = e.clientY || (rect.top + rect.height / 2);

            // Spawn Rock Dust Debris Particles
            for (let i = 0; i < 5; i++) {
                const chip = document.createElement('div');
                chip.className = 'rock-chip';
                const color = Math.random() > 0.4 ? '#64748b' : (Math.random() > 0.5 ? '#06b6d4' : '#f59e0b');
                chip.style.backgroundColor = color;
                chip.style.left = `${x}px`;
                chip.style.top = `${y}px`;
                
                const angle = Math.random() * Math.PI * 2;
                const distance = 40 + Math.random() * 60;
                chip.style.setProperty('--dx', `${Math.cos(angle) * distance}px`);
                chip.style.setProperty('--dy', `${Math.sin(angle) * distance}px`);
                
                document.body.appendChild(chip);
                setTimeout(() => chip.remove(), 700);
            }

            // Spawn floating +$ particle
            const particle = document.createElement('div');
            particle.className = 'click-particle';
            particle.innerText = `+$${formatNumber(clickVal)}`;
            particle.style.left = `${x}px`;
            particle.style.top = `${y}px`;

            document.body.appendChild(particle);
            setTimeout(() => particle.remove(), 1200);

            renderUI();
        };

        // Manual Click Upgrade Button
        document.getElementById('btn-upgrade-click').onclick = () => {
            if (state.cash >= state.clickCost) {
                state.cash -= state.clickCost;
                state.clickLevel = (state.clickLevel || 1) + 1;
                state.clickPower += 1;
                state.clickCost = Math.floor(state.clickCost * 1.6);
                sounds.playBuy();
                renderUI();
            }
        };

        /**
         * BULK BUY MODE TOGGLES
         */
        document.querySelectorAll('.buy-mode-btn').forEach(btn => {
            btn.onclick = () => {
                document.querySelectorAll('.buy-mode-btn').forEach(b => {
                    b.classList.remove('bg-cyan-500', 'text-slate-950', 'font-bold');
                    b.classList.add('hover:bg-slate-800', 'text-slate-300');
                });
                btn.classList.add('bg-cyan-500', 'text-slate-950', 'font-bold');
                btn.classList.remove('hover:bg-slate-800', 'text-slate-300');
                buyMode = btn.dataset.buy;
                renderUI();
            };
        });

        /**
         * TAB NAVIGATION
         */
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.onclick = () => {
                document.querySelectorAll('.tab-btn').forEach(b => {
                    b.classList.remove('bg-cyan-500', 'text-slate-950');
                    b.classList.add('hover:bg-slate-800/80', 'text-slate-400');
                });
                btn.classList.add('bg-cyan-500', 'text-slate-950');
                btn.classList.remove('hover:bg-slate-800/80', 'text-slate-400');

                document.querySelectorAll('.tab-page').forEach(page => page.classList.add('hidden'));
                document.getElementById(`tab-content-${btn.dataset.tab}`).classList.remove('hidden');
            };
        });

        /**
         * RANDOM GOLDEN METEOR SUPPLY DROP SYSTEM
         */
        function spawnSupplyMeteor() {
            const meteor = document.createElement('div');
            meteor.className = 'fixed z-40 supply-meteor cursor-pointer text-4xl p-2 rounded-full bg-amber-500/20 border border-amber-400/60 shadow-lg shadow-amber-500/40 animate-pulse';
            meteor.innerText = '🌠';
            meteor.style.top = `${Math.random() * 60 + 10}vh`;

            meteor.onclick = () => {
                sounds.playMeteor();
                meteor.remove();

                // 50% chance cash burst, 50% Frenzy multiplier
                if (Math.random() > 0.5) {
                    const bonus = Math.max(500, getGlobalCPS() * 30);
                    state.cash += bonus;
                    state.lifetimeCash += bonus;
                    showDialog({
                        title: '🌠 CELESTIAL METEOR CLAIMED!',
                        message: `Extracted instant supply burst of +$${formatNumber(bonus)} credits!`
                    });
                } else {
                    frenzyActive = true;
                    frenzyTimeLeft = 20 + (state.perks['perk_frenzy'] || 0) * 5;
                    frenzyMultiplier = 2 + (state.perks['perk_frenzy'] || 0);
                    document.getElementById('frenzy-multiplier-text').innerText = `${frenzyMultiplier}x`;
                    document.getElementById('frenzy-banner').classList.remove('hidden');
                }
                renderUI();
            };

            document.body.appendChild(meteor);
            setTimeout(() => meteor.remove(), 12000);
        }

        // Schedule meteor every 45-90 seconds
        setInterval(() => {
            if (Math.random() < 0.7) spawnSupplyMeteor();
        }, 60000);

        /**
         * PRESTIGE REBIRTH EXECUTION
         */
        document.getElementById('btn-rebirth').onclick = () => {
            const potentialDM = Math.floor(15 * Math.sqrt(state.lifetimeCash / 1e7));
            if (potentialDM <= 0) return;

            showDialog({
                title: '🌌 INITIATE GALACTIC REBIRTH?',
                message: `You will reset all current cash and facilities to gain +${potentialDM} Dark Matter Shares (+${potentialDM * 5}% global revenue boost)!`,
                showCancel: true,
                onConfirm: () => {
                    state.darkMatter += potentialDM;
                    state.totalPrestiges++;
                    
                    // Reset cash & facilities
                    const bonusCash = (state.perks['perk_grant'] || 0) * 5000;
                    state.cash = bonusCash;
                    state.clickPower = 1;
                    state.clickLevel = 1;
                    state.clickCost = 10;

                    GENERATORS_CONFIG.forEach(g => {
                        state.generators[g.id] = { level: 0, progress: 0, running: false };
                        state.managers[g.id] = false;
                    });
                    UPGRADES_CONFIG.forEach(u => {
                        state.upgrades[u.id] = false;
                    });

                    sounds.playUpgrade();
                    renderUI();
                }
            });
        };

        /**
         * LIVE SPARKLINE CANVAS GRAPH
         */
        const sparkCanvas = document.getElementById('sparkline');
        const sparkCtx = sparkCanvas.getContext('2d');

        function updateSparkline(cps) {
            sparklineData.push(cps);
            sparklineData.shift();

            sparkCtx.clearRect(0, 0, sparkCanvas.width, sparkCanvas.height);
            const max = Math.max(...sparklineData, 1);
            
            sparkCtx.beginPath();
            sparkCtx.strokeStyle = '#38bdf8';
            sparkCtx.lineWidth = 1.5;

            sparklineData.forEach((val, i) => {
                const x = (i / (sparklineData.length - 1)) * sparkCanvas.width;
                const y = sparkCanvas.height - (val / max) * (sparkCanvas.height - 4) - 2;
                if (i === 0) sparkCtx.moveTo(x, y);
                else sparkCtx.lineTo(x, y);
            });
            sparkCtx.stroke();
        }

        /**
         * GAME LOOP ENGINE (100ms Ticks)
         */
        let lastTick = Date.now();

        setInterval(() => {
            const now = Date.now();
            const dt = (now - lastTick) / 1000;
            lastTick = now;

            state.timePlayed += dt;

            // Update Frenzy Timer
            if (frenzyActive) {
                frenzyTimeLeft -= dt;
                document.getElementById('frenzy-timer').innerText = `${Math.max(0, frenzyTimeLeft).toFixed(1)}s`;
                if (frenzyTimeLeft <= 0) {
                    frenzyActive = false;
                    document.getElementById('frenzy-banner').classList.add('hidden');
                }
            }

            // Update Generators Cycle Progress & Income Logic
            GENERATORS_CONFIG.forEach(g => {
                const genState = state.generators[g.id];
                const isAutomated = state.managers[g.id];

                if (genState.level > 0) {
                    // Automated facilities are ALWAYS running
                    if (isAutomated) {
                        genState.running = true;
                    }

                    if (genState.running) {
                        const speed = g.baseSpeed * Math.max(0.5, 1 - (state.perks['perk_warp'] || 0) * 0.10);
                        genState.progress += (100 / speed) * dt;

                        if (genState.progress >= 100) {
                            // Calculate earned payout with Beacon global multiplier and Math.ceil rounding
                            let genIncome = g.baseIncome * genState.level;

                            UPGRADES_CONFIG.forEach(u => {
                                if (u.targetGen === g.id && state.upgrades[u.id]) genIncome *= u.multiplier;
                            });

                            let globalMult = 1.0 + state.darkMatter * 0.05;
                            globalMult *= getBeaconMultiplier();
                            UPGRADES_CONFIG.forEach(u => { if (u.isGlobal && state.upgrades[u.id]) globalMult *= u.multiplier; });
                            if (frenzyActive) globalMult *= frenzyMultiplier;

                            const finalEarned = Math.ceil(genIncome * globalMult);
                            state.cash += finalEarned;
                            state.lifetimeCash += finalEarned;

                            if (isAutomated) {
                                // Continuous automation reset and immediately restart next loop!
                                genState.progress %= 100;
                            } else {
                                // Manual run completed
                                genState.progress = 0;
                                genState.running = false;
                            }
                        }
                    }
                } else {
                    genState.progress = 0;
                    genState.running = false;
                }
            });

            updateSparkline(getGlobalCPS());
            renderUI();
        }, 100);

        /**
         * LOCAL STORAGE SAVE & OFFLINE PROGRESS SYSTEM
         */
        const SAVE_KEY = 'astro_corp_tycoon_save';

        function saveGame() {
            state.lastSaveTime = Date.now();
            localStorage.setItem(SAVE_KEY, JSON.stringify(state));
        }

        function loadGame() {
            const raw = localStorage.getItem(SAVE_KEY);
            if (!raw) return;
            try {
                const loaded = JSON.parse(raw);
                state = { ...state, ...loaded };
                initInitialState();

                // Calculate Offline Earnings
                const now = Date.now();
                const elapsedSeconds = Math.floor((now - (state.lastSaveTime || now)) / 1000);

                if (elapsedSeconds > 10) {
                    const cps = getGlobalCPS();
                    const offlineEarnings = Math.floor(cps * elapsedSeconds * 0.5); // 50% offline rate

                    if (offlineEarnings > 0) {
                        state.cash += offlineEarnings;
                        state.lifetimeCash += offlineEarnings;

                        document.getElementById('offline-cash-display').innerText = `+$${formatNumber(offlineEarnings)}`;
                        document.getElementById('offline-time-display').innerText = `Away for ${Math.floor(elapsedSeconds / 60)}m ${elapsedSeconds % 60}s`;
                        document.getElementById('modal-offline').classList.remove('hidden');
                    }
                }
            } catch (err) {
                console.error('Save file load error:', err);
            }
        }

        // Auto Save every 5 seconds
        setInterval(saveGame, 5000);

        document.getElementById('btn-claim-offline').onclick = () => {
            document.getElementById('modal-offline').classList.add('hidden');
            renderUI();
        };

        /**
         * AUDIO & DATA MANAGEMENT MODAL HANDLERS
         */
        document.getElementById('btn-sound').onclick = () => {
            const isMuted = sounds.toggleMute();
            document.getElementById('icon-sound-on').classList.toggle('hidden', isMuted);
            document.getElementById('icon-sound-off').classList.toggle('hidden', !isMuted);
        };

        document.getElementById('btn-stats').onclick = () => {
            document.getElementById('stat-lifetime-cash').innerText = `$${formatNumber(state.lifetimeCash)}`;
            document.getElementById('stat-total-clicks').innerText = state.totalClicks.toLocaleString();
            document.getElementById('stat-total-prestiges').innerText = state.totalPrestiges;
            document.getElementById('stat-time-played').innerText = `${Math.floor(state.timePlayed / 60)}m ${Math.floor(state.timePlayed % 60)}s`;
            document.getElementById('modal-stats').classList.remove('hidden');
        };

        document.getElementById('btn-close-stats').onclick = () => {
            document.getElementById('modal-stats').classList.add('hidden');
        };

        // Export Save JSON
        document.getElementById('btn-export-save').onclick = () => {
            saveGame();
            const b64 = btoa(JSON.stringify(state));
            showDialog({
                title: '📤 EXPORT SAVE DATA',
                message: 'Copy your encoded save string below to back up your progress:',
                showInput: true,
                inputValue: b64,
                onConfirm: () => {
                    const inputEl = document.getElementById('dialog-input');
                    inputEl.classList.remove('hidden');
                    inputEl.select();
                    try { document.execCommand('copy'); } catch (e) {}
                    inputEl.classList.add('hidden');
                }
            });
        };

        // Import Save JSON
        document.getElementById('btn-import-save').onclick = () => {
            showDialog({
                title: '📥 IMPORT SAVE DATA',
                message: 'Paste your Astro-Corp save string below:',
                showCancel: true,
                showInput: true,
                onConfirm: (str) => {
                    if (str && str.trim()) {
                        try {
                            const parsed = JSON.parse(atob(str.trim()));
                            state = parsed;
                            initInitialState();
                            saveGame();
                            renderUI();
                            showDialog({ title: 'SUCCESS', message: 'Save imported successfully!' });
                        } catch (e) {
                            showDialog({ title: 'ERROR', message: 'Invalid save string!' });
                        }
                    }
                }
            });
        };

        // Hard Reset Data
        document.getElementById('btn-hard-reset').onclick = () => {
            showDialog({
                title: '⚠️ HARD RESET ALL DATA',
                message: 'Are you sure you want to completely erase ALL corporate progress? This cannot be undone.',
                showCancel: true,
                onConfirm: () => {
                    localStorage.removeItem(SAVE_KEY);
                    location.reload();
                }
            });
        };

        // Initialize Game Load
        window.onload = () => {
            loadGame();
            renderUI();
        };
    </script>
</body>
</html>
