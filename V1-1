<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Astro-Corp: Galactic Mining Tycoon</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800;900&family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            user-select: none;
            -webkit-user-select: none;
            touch-action: manipulation;
        }
        body {
            font-family: 'Inter', sans-serif;
            background-color: #080c14;
            color: #f1f5f9;
            overflow-x: hidden;
        }
        .font-orbitron {
            font-family: 'Orbitron', sans-serif;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.6);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(56, 189, 248, 0.3);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(56, 189, 248, 0.6);
        }
        /* Glassmorphism Styles */
        .glass-panel {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(56, 189, 248, 0.15);
        }
        .glass-panel-interactive {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(56, 189, 248, 0.15);
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .glass-panel-interactive:hover {
            border-color: rgba(56, 189, 248, 0.4);
            box-shadow: 0 0 20px rgba(56, 189, 248, 0.15);
        }
        /* Neon Lighting Shadows */
        .glow-cyan {
            box-shadow: 0 0 20px rgba(6, 182, 212, 0.35);
        }
        .glow-amber {
            box-shadow: 0 0 20px rgba(245, 158, 11, 0.35);
        }
        .glow-purple {
            box-shadow: 0 0 20px rgba(168, 85, 247, 0.35);
        }
        .text-glow-cyan {
            text-shadow: 0 0 10px rgba(6, 182, 212, 0.6);
        }
        .text-glow-amber {
            text-shadow: 0 0 10px rgba(245, 158, 11, 0.6);
        }

        /* Asteroid Pulsing & Floating Animations */
        @keyframes floatSlow {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-8px) rotate(3deg); }
        }
        .animate-float {
            animation: floatSlow 5s ease-in-out infinite;
        }

        @keyframes pulseGlow {
            0%, 100% { filter: drop-shadow(0 0 15px rgba(6, 182, 212, 0.4)); }
            50% { filter: drop-shadow(0 0 30px rgba(168, 85, 247, 0.6)); }
        }
        .asteroid-glow {
            animation: pulseGlow 4s ease-in-out infinite;
        }

        /* Click Particles Floating Up */
        .click-particle {
            position: absolute;
            pointer-events: none;
            font-family: 'Orbitron', sans-serif;
            font-weight: 800;
            color: #38bdf8;
            text-shadow: 0 0 8px rgba(56, 189, 248, 0.8);
            animation: floatAndFade 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) forwards;
            z-index: 50;
        }
        @keyframes floatAndFade {
            0% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
            50% { transform: translate(-50%, -100px) scale(1.2); opacity: 0.9; }
            100% { opacity: 0; transform: translate(-50%, -150px) scale(0.9); }
        }

        /* Supply Meteor Event Floating Across Screen */
        @keyframes meteorFly {
            0% { transform: translate(-100px, 10vh) rotate(0deg); }
            100% { transform: translate(calc(100vw + 100px), 80vh) rotate(360deg); }
        }
        .supply-meteor {
            animation: meteorFly 12s linear forwards;
        }

        /* Rock Debris Chip Particle Animation */
        .rock-chip {
            position: absolute;
            pointer-events: none;
            width: 8px;
            height: 8px;
            border-radius: 2px;
            animation: chipFly 0.7s cubic-bezier(0.1, 0.8, 0.3, 1) forwards;
            z-index: 45;
        }
        @keyframes chipFly {
            0% { opacity: 1; transform: translate(-50%, -50%) scale(1) rotate(0deg); }
            100% { opacity: 0; transform: translate(var(--dx), var(--dy)) scale(0.3) rotate(360deg); }
        }
    </style>
</head>
<body class="min-h-screen text-slate-100 relative selection:bg-cyan-500/30">

    <!-- Background Stars Overlay -->
    <div class="fixed inset-0 pointer-events-none z-0 opacity-40 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-cyan-900/20 via-slate-950 to-black"></div>

    <!-- MAIN APP WRAPPER -->
    <div class="relative z-10 flex flex-col min-h-screen max-w-7xl mx-auto px-3 sm:px-6 py-4">

        <!-- TOP BAR / HEADER STICKY PANEL -->
        <header class="glass-panel rounded-2xl p-4 mb-4 flex flex-col lg:flex-row items-center justify-between gap-4 border border-cyan-500/20 shadow-xl">
            <!-- Brand & Rank -->
            <div class="flex items-center gap-3 w-full lg:w-auto justify-between lg:justify-start">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-cyan-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-cyan-500/20 font-orbitron font-black text-2xl text-white">
                        🚀
                    </div>
                    <div>
                        <h1 class="font-orbitron font-extrabold text-xl sm:text-2xl tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-indigo-400">
                            ASTRO-CORP
                        </h1>
                        <div class="text-xs text-slate-400 font-medium flex items-center gap-2">
                            <span>GALACTIC MINING TYCOON</span>
                            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-ping"></span>
                        </div>
                    </div>
                </div>

                <!-- Sound & Settings Buttons -->
                <div class="flex items-center gap-2">
                    <button id="btn-sound" class="p-2.5 rounded-xl bg-slate-800/80 hover:bg-slate-700 text-cyan-400 border border-slate-700/60 transition active:scale-95" title="Toggle Sound FX">
                        <svg id="icon-sound-on" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path></svg>
                        <svg id="icon-sound-off" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15zM17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"></path></svg>
                    </button>
                    <button id="btn-stats" class="p-2.5 rounded-xl bg-slate-800/80 hover:bg-slate-700 text-slate-300 border border-slate-700/60 transition active:scale-95" title="Stats & Data Management">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                    </button>
                </div>
            </div>

            <!-- Financial Metrics Dashboard -->
            <div class="grid grid-cols-2 md:grid-cols-3 lg:flex items-center gap-4 w-full lg:w-auto">
                <!-- Current Cash -->
                <div class="bg-slate-900/80 border border-slate-800 rounded-xl px-4 py-2 flex flex-col min-w-[140px]">
                    <span class="text-[10px] font-orbitron text-slate-400 tracking-wider">NET CREDITS</span>
                    <div class="flex items-center gap-1">
                        <span class="text-cyan-400 font-bold">$</span>
                        <span id="display-cash" class="font-orbitron font-extrabold text-xl sm:text-2xl text-cyan-300 text-glow-cyan">0</span>
                    </div>
                </div>

                <!-- Cash Per Second -->
                <div class="bg-slate-900/80 border border-slate-800 rounded-xl px-4 py-2 flex flex-col min-w-[140px]">
                    <span class="text-[10px] font-orbitron text-slate-400 tracking-wider">REVENUE / SEC</span>
                    <div class="flex items-center gap-1">
                        <span class="text-emerald-400 font-bold">+$</span>
                        <span id="display-cps" class="font-orbitron font-bold text-lg text-emerald-400">0</span>
                    </div>
                </div>

                <!-- Quantum Beacons -->
                <div class="bg-slate-900/80 border border-cyan-500/40 rounded-xl px-4 py-2 flex flex-col min-w-[140px]">
                    <span class="text-[10px] font-orbitron text-cyan-400 tracking-wider">QUANTUM BEACONS</span>
                    <div class="flex items-center justify-between gap-2">
                        <span id="display-beacons" class="font-orbitron font-bold text-lg text-cyan-300">📡 0</span>
                        <span id="display-beacon-bonus" class="text-xs font-bold text-cyan-300 bg-cyan-500/20 px-2 py-0.5 rounded border border-cyan-500/40 text-glow-cyan">+0%</span>
                    </div>
                </div>

                <!-- Dark Matter (Prestige Currency) -->
                <div class="bg-slate-900/80 border border-purple-950/60 rounded-xl px-4 py-2 flex flex-col min-w-[140px] col-span-2 md:col-span-1">
                    <span class="text-[10px] font-orbitron text-purple-400 tracking-wider">DARK MATTER</span>
                    <div class="flex items-center justify-between">
                        <span id="display-dm" class="font-orbitron font-bold text-lg text-purple-300">0 DM</span>
                        <span id="display-multiplier" class="text-xs font-bold text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20">1x</span>
                    </div>
                </div>
            </div>

            <!-- Sparkline Mini Revenue Canvas -->
            <div class="hidden xl:flex flex-col items-end gap-1">
                <span class="text-[10px] font-orbitron text-slate-400">LIVE REVENUE TREND</span>
                <canvas id="sparkline" width="120" height="32" class="rounded bg-slate-950/50 border border-slate-800/80"></canvas>
            </div>
        </header>

        <!-- ACTIVE FRENZY NOTIFICATION BANNER (Hidden by default) -->
        <div id="frenzy-banner" class="hidden mb-4 glass-panel p-3 rounded-xl border border-amber-500/50 bg-gradient-to-r from-amber-500/20 via-purple-600/20 to-cyan-500/20 flex items-center justify-between animate-pulse">
            <div class="flex items-center gap-3">
                <span class="text-2xl">⚡</span>
                <div>
                    <h3 class="font-orbitron font-bold text-amber-300 text-sm">STARDUST FRENZY ACTIVE!</h3>
                    <p class="text-xs text-amber-200/80">All generator profits multiplied by <span id="frenzy-multiplier-text" class="font-bold text-white">2x</span>!</p>
                </div>
            </div>
            <div class="font-orbitron font-black text-xl text-amber-300" id="frenzy-timer">20.0s</div>
        </div>

        <!-- BEACON UNLOCKED CELEBRATORY TOAST BANNER -->
        <div id="beacon-toast" class="hidden mb-4 glass-panel p-3 rounded-xl border border-cyan-400/80 bg-gradient-to-r from-cyan-950/90 via-sky-900/80 to-indigo-950/90 flex items-center justify-between shadow-lg shadow-cyan-500/20 animate-bounce">
            <div class="flex items-center gap-3">
                <span class="text-2xl">📡</span>
                <div>
                    <h3 id="beacon-toast-title" class="font-orbitron font-extrabold text-cyan-300 text-sm tracking-wider">BEACON UNLOCKED!</h3>
                    <p id="beacon-toast-desc" class="text-xs text-cyan-100">Facility milestone reached! Global production boosted by +10%.</p>
                </div>
            </div>
            <span class="text-xs font-orbitron font-bold text-cyan-400 bg-cyan-500/20 px-2.5 py-1 rounded-lg border border-cyan-400/40">+10% ALL OUTPUT</span>
        </div>

        <!-- MAIN WORKSPACE GRID -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">

            <!-- LEFT COLUMN: MINING CORE & GENERATORS (LG: 7 COLS) -->
            <div class="lg:col-span-7 flex flex-col gap-5">

                <!-- INTERACTIVE ROCKY ASTEROID MINING CORE PANEL -->
                <div class="glass-panel rounded-2xl p-6 border border-cyan-500/20 flex flex-col md:flex-row items-center gap-6 relative overflow-hidden">
                    <!-- Left: Clickable Rocky Asteroid SVG -->
                    <div class="relative flex-shrink-0 flex items-center justify-center w-44 h-44">
                        <div id="mine-ripple" class="absolute inset-0 rounded-full bg-cyan-400/20 scale-110 opacity-0 transition-opacity duration-150 pointer-events-none"></div>
                        <button id="btn-mine" class="relative w-40 h-40 rounded-full flex items-center justify-center cursor-pointer transition-transform active:scale-90 animate-float asteroid-glow focus:outline-none group" title="Click to Mine Mineral Core">
                            <!-- Detailed Rocky Asteroid Vector Graphic -->
                            <svg viewBox="0 0 200 200" class="w-full h-full drop-shadow-2xl">
                                <defs>
                                    <radialGradient id="rockGrad" cx="35%" cy="35%" r="65%">
                                        <stop offset="0%" stop-color="#64748b"/>
                                        <stop offset="55%" stop-color="#334155"/>
                                        <stop offset="100%" stop-color="#0f172a"/>
                                    </radialGradient>
                                    <linearGradient id="veinCyan" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#22d3ee"/>
                                        <stop offset="100%" stop-color="#0284c7"/>
                                    </linearGradient>
                                    <linearGradient id="veinGold" x1="0%" y1="100%" x2="100%" y2="0%">
                                        <stop offset="0%" stop-color="#fbbf24"/>
                                        <stop offset="100%" stop-color="#d97706"/>
                                    </linearGradient>
                                </defs>
                                <!-- Irregular Craggy Asteroid Body -->
                                <polygon points="100,14 142,24 176,55 186,102 172,148 134,180 86,186 42,166 18,124 22,74 56,34" fill="url(#rockGrad)" stroke="#475569" stroke-width="3" stroke-linejoin="round"/>
                                <!-- Craters & Depth Shading -->
                                <ellipse cx="68" cy="64" rx="18" ry="13" transform="rotate(-20 68 64)" fill="#1e293b" stroke="#475569" stroke-width="1.5"/>
                                <ellipse cx="136" cy="128" rx="22" ry="15" transform="rotate(15 136 128)" fill="#1e293b" stroke="#475569" stroke-width="1.5"/>
                                <circle cx="132" cy="66" r="10" fill="#1e293b" stroke="#475569" stroke-width="1.5"/>
                                <circle cx="72" cy="138" r="12" fill="#1e293b" stroke="#475569" stroke-width="1.5"/>
                                <!-- Glowing Cyan Mineral Veins -->
                                <path d="M56,34 L82,78 L112,92 L142,24" fill="none" stroke="url(#veinCyan)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M18,124 L65,112 L95,142 L86,186" fill="none" stroke="url(#veinCyan)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                                <!-- Glowing Gold Mineral Veins -->
                                <path d="M176,55 L130,96 L146,136 L172,148" fill="none" stroke="url(#veinGold)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                                <circle cx="96" cy="102" r="5" fill="#38bdf8" class="animate-ping"/>
                            </svg>
                        </button>
                    </div>

                    <!-- Right: Mining Stats & Click Boost Info -->
                    <div class="flex-1 text-center md:text-left space-y-3">
                        <div class="inline-block px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 font-orbitron text-xs font-semibold">
                            MANUAL EXTRACTION NODE
                        </div>
                        <h2 class="font-orbitron font-extrabold text-2xl text-slate-100">
                            MINING CORE #01
                        </h2>
                        <p class="text-xs text-slate-400 leading-relaxed">
                            Click the mineral core to extract localized credit deposits. Upgrade manual lasers to boost per-click earnings.
                        </p>
                        <div class="pt-2 flex flex-wrap items-center justify-center md:justify-start gap-4">
                            <div class="bg-slate-900/90 border border-slate-800 px-4 py-2 rounded-xl">
                                <div class="text-[10px] font-orbitron text-slate-400">PER CLICK</div>
                                <div id="display-click-power" class="font-orbitron font-bold text-cyan-300 text-lg">+$1</div>
                            </div>
                            <button id="btn-upgrade-click" class="px-4 py-2 bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 text-white font-orbitron font-bold text-xs rounded-xl shadow-lg shadow-cyan-500/20 transition active:scale-95 disabled:opacity-40 disabled:pointer-events-none flex flex-col items-center">
                                <span>UPGRADE LASER</span>
                                <span id="display-click-cost" class="text-[10px] text-cyan-200 font-normal">$25</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- GENERATORS LIST CONTAINER -->
                <div class="glass-panel rounded-2xl p-4 sm:p-5 border border-slate-800 flex flex-col gap-4">
                    
                    <!-- Header with Bulk Buy Toggles -->
                    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pb-3 border-b border-slate-800">
                        <div>
                            <h3 class="font-orbitron font-extrabold text-lg text-slate-100 flex items-center gap-2">
                                <span>MINING FACILITIES</span>
                                <span class="text-xs font-normal text-slate-400 font-sans">(Automated Tiers)</span>
                            </h3>
                        </div>

                        <!-- Bulk Buy Mode Selectors -->
                        <div class="flex items-center gap-1 bg-slate-900/90 p-1 rounded-xl border border-slate-800 text-xs font-orbitron w-full sm:w-auto justify-center">
                            <span class="text-slate-400 px-2 text-[10px]">BUY:</span>
                            <button data-buy="1" class="buy-mode-btn px-3 py-1 rounded-lg bg-cyan-500 text-slate-950 font-bold transition">x1</button>
                            <button data-buy="10" class="buy-mode-btn px-3 py-1 rounded-lg hover:bg-slate-800 text-slate-300 transition">x10</button>
                            <button data-buy="100" class="buy-mode-btn px-3 py-1 rounded-lg hover:bg-slate-800 text-slate-300 transition">x100</button>
                            <button data-buy="max" class="buy-mode-btn px-3 py-1 rounded-lg hover:bg-slate-800 text-slate-300 transition">MAX</button>
                        </div>
                    </div>

                    <!-- Dynamic Generator Tiers Container -->
                    <div id="generators-container" class="flex flex-col gap-3">
                        <!-- Generator Cards injected via JS -->
                    </div>

                </div>
            </div>

            <!-- RIGHT COLUMN: MULTI-TAB NAVIGATION PANEL (LG: 5 COLS) -->
            <div class="lg:col-span-5 flex flex-col gap-4">
                
                <!-- Tab Selector Buttons -->
                <div class="glass-panel p-1.5 rounded-2xl flex items-center gap-1 border border-slate-800 text-xs font-orbitron font-bold">
                    <button data-tab="managers" class="tab-btn flex-1 py-3 rounded-xl bg-cyan-500 text-slate-950 shadow-md transition flex items-center justify-center gap-1.5">
                        <span>👔</span>
                        <span>MANAGERS</span>
                    </button>
                    <button data-tab="upgrades" class="tab-btn flex-1 py-3 rounded-xl hover:bg-slate-800/80 text-slate-400 transition flex items-center justify-center gap-1.5">
                        <span>🔬</span>
                        <span>TECH</span>
                    </button>
                    <button data-tab="prestige" class="tab-btn flex-1 py-3 rounded-xl hover:bg-slate-800/80 text-slate-400 transition flex items-center justify-center gap-1.5">
                        <span>🌌</span>
                        <span>REBIRTH</span>
                    </button>
                </div>

                <!-- TAB CONTENT 1: MANAGERS & AUTOMATION -->
                <div id="tab-content-managers" class="tab-page glass-panel rounded-2xl p-5 border border-slate-800 space-y-4">
                    <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                        <div>
                            <h3 class="font-orbitron font-bold text-cyan-400 text-base">EXECUTIVE MANAGERS</h3>
                            <p class="text-xs text-slate-400">Hire managers to automate production cycles continuously.</p>
                        </div>
                    </div>
                    
                    <div id="managers-list" class="flex flex-col gap-3 max-h-[550px] overflow-y-auto pr-1">
                        <!-- Dynamic Manager Cards -->
                    </div>
                </div>

                <!-- TAB CONTENT 2: TECH UPGRADES -->
                <div id="tab-content-upgrades" class="tab-page hidden glass-panel rounded-2xl p-5 border border-slate-800 space-y-4">
                    <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                        <div>
                            <h3 class="font-orbitron font-bold text-cyan-400 text-base">RESEARCH & TECH</h3>
                            <p class="text-xs text-slate-400">Unlock permanent global and facility efficiency upgrades.</p>
                        </div>
                    </div>

                    <div id="upgrades-list" class="flex flex-col gap-3 max-h-[550px] overflow-y-auto pr-1">
                        <!-- Dynamic Upgrade Cards -->
                    </div>
                </div>

                <!-- TAB CONTENT 3: PRESTIGE / REBIRTH (GALACTIC EXPANSION) -->
                <div id="tab-content-prestige" class="tab-page hidden glass-panel rounded-2xl p-5 border border-purple-900/40 space-y-5 bg-gradient-to-b from-purple-950/20 to-slate-900/80">
                    <div>
                        <div class="inline-block px-3 py-1 rounded-full bg-purple-500/20 border border-purple-500/40 text-purple-300 font-orbitron text-[10px] font-bold mb-2">
                            GALACTIC CORPORATE REBIRTH
                        </div>
                        <h3 class="font-orbitron font-extrabold text-xl text-slate-100">
                            IPO & DARK MATTER EXPANSION
                        </h3>
                        <p class="text-xs text-slate-300 leading-relaxed mt-1">
                            Reset your current mining facilities and credit balance to earn permanent <strong class="text-purple-400">Dark Matter Shares</strong>. Each share grants +5% all revenue!
                        </p>
                    </div>

                    <!-- Rebirth Status Box -->
                    <div class="bg-slate-900/90 border border-purple-800/50 p-4 rounded-xl space-y-3">
                        <div class="flex justify-between text-xs font-orbitron">
                            <span class="text-slate-400">CURRENT DM SHARES:</span>
                            <span id="prestige-current-dm" class="text-purple-300 font-bold">0 DM</span>
                        </div>
                        <div class="flex justify-between text-xs font-orbitron">
                            <span class="text-slate-400">CURRENT MULTIPLIER:</span>
                            <span id="prestige-current-multi" class="text-amber-400 font-bold">1.00x</span>
                        </div>
